# PG Analytics environment variables.
# Copy to .env (repo root, used by ingestion) and web/.env.local (used by Next.js),
# then fill in real values. NEVER commit .env or .env.local. NEVER paste values into chat or tickets.

# --- Supabase ----------------------------------------------------------------
# Project URL. Local: http://127.0.0.1:54321 (from `supabase status`).
# Production project must be in Sydney (ap-southeast-2).
SUPABASE_URL=
# Public anon key. Safe for the browser, because RLS does the filtering.
SUPABASE_ANON_KEY=
# Service-role key. Bypasses RLS. Server-side only (ingestion, web/lib/server-admin.ts). Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by ingestion and tests.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- Encryption --------------------------------------------------------------
# 32 random bytes, base64. Generate with scripts/gen-key.sh. Encrypts per-client tokens
# in reporting.connection_secrets (AES-256-GCM). Losing it means re-connecting every client token.
PGA_ENCRYPTION_KEY=
# Version number of PGA_ENCRYPTION_KEY (stored with each ciphertext). Bump it when you rotate.
PGA_ENCRYPTION_KEY_VERSION=1
# Only during a key rotation: old keys still needed to decrypt, as "1:<base64>,2:<base64>".
PGA_ENCRYPTION_KEYS_PREVIOUS=

# --- Ingestion ---------------------------------------------------------------
# Days re-pulled on every run (conversions get revised after the fact).
PGA_DEFAULT_LOOKBACK_DAYS=30
# Where PyAirbyte installs connector virtualenvs (outside the repo). Default:
# ~/.cache/pganalytics/connectors
PGA_AIRBYTE_INSTALL_DIR=

# --- Google Ads (agency MCC) -------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Legacy. Google sunsets developer tokens on 9 Sep 2026, but the connector still wants
# a non-empty value, so a placeholder is fine.
GOOGLE_ADS_DEVELOPER_TOKEN=placeholder
# Our manager account (MCC) customer ID, digits only, no dashes. For reference and
# direct API calls: the Airbyte connector (v6+) finds the MCC itself and doesn't use it.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta (system user) ------------------------------------------------------
# System user token with read-only ads scopes (ads_read). Never ads_management.
META_SYSTEM_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- Google service account (GA4 + Search Console) ---------------------------
# Path to the service account JSON key file, kept OUTSIDE the repo.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# --- Google Business Profile -------------------------------------------------
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# --- LinkedIn Ads ------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- TikTok Ads --------------------------------------------------------------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# --- Microsoft Ads (agency manager account) ----------------------------------
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
# Expires after 90 days without use. The nightly sync keeps it alive.
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=

# --- Claude API (report commentary) ------------------------------------------
ANTHROPIC_API_KEY=
# Model ID used for commentary (Phase 5).
ANTHROPIC_MODEL=

# --- Email (report notifications) --------------------------------------------
REPORT_FROM_EMAIL=
# Use EITHER Resend OR SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Web app (Next.js) -------------------------------------------------------
# Next.js only exposes NEXT_PUBLIC_* to the browser. These two are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
