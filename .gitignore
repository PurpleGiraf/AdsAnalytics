# --- Secrets: never commit ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# Service account / OAuth key files. Any JSON that must be committed (fixtures,
# configs) is re-allowed explicitly below.
*.json
!**/package.json
!**/package-lock.json
!**/tsconfig.json
!**/tests/fixtures/**/*.json
!.vscode/*.json
!supabase/**/*.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.duckdb
.cache/

# --- Node / Next.js ----------------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# --- Supabase local ----------------------------------------------------------
supabase/.branches/
supabase/.temp/

# --- OS / editors ------------------------------------------------------------
.DS_Store
.idea/
